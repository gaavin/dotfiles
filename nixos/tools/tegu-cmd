#!/usr/bin/env bash
# Send a shell command to the tegu phone and get the answer over UART.
#
# Usage:  tools/tegu-cmd 'cat /proc/cmdline'
#         tools/tegu-cmd -f script.sh
#
# Rebuilds only vendor_boot -- 24 KB, about ten milliseconds to flash -- with
# the command base64'd onto its vendor_cmdline, and flashes it. Reboot the
# phone and the reply comes back on the UART, prefixed "tegu-cmd:".
#
# This exists because the debug loop was otherwise a four-minute rootfs
# reflash for every question, and the UART on this board cannot be typed into.
set -euo pipefail

fastboot=$(command -v fastboot || echo /nix/store/mcbpd0lzv6gl5pan8njd72wzczi3v3r2-android-tools-37.0.0/bin/fastboot)
# Same rule as flash.sh: name the device when more than one is attached,
# because fastboot with no serial quietly picks one for you.
fbargs=()
[ -n "${FASTBOOT_SERIAL:-}" ] && fbargs=(-s "$FASTBOOT_SERIAL")
mkbootimg=$(command -v mkbootimg || echo /nix/store/mcbpd0lzv6gl5pan8njd72wzczi3v3r2-android-tools-37.0.0/bin/mkbootimg)

if [ "${1:-}" = "-f" ]; then
	cmd=$(cat "$2")
else
	cmd="${1:?usage: tegu-cmd '<shell command>' | tegu-cmd -f script.sh}"
fi

# This script lives in nixos/tools, so one level up is the flake itself.
flake=$(cd "$(dirname "$0")/.." && pwd)
# Sending a command must not depend on building anything: only the dtb and
# the cmdline length are needed, and both belong to the image already on
# the phone. Point TEGU_IMG at it. Without this an unrelated kernel edit
# turns "ask the phone a question" into a twenty-minute rebuild.
img=${TEGU_IMG:-$(nix build --no-link --print-out-paths "$flake#tegu-images")}
# Only for the size budget: boot.img already carries this exact string and
# ABL concatenates both cmdlines, so vendor_boot must NOT repeat it.
#
# It used to. That put a second init= on the command line naming whichever
# system the flake happened to build, and the last init= wins -- so the moment
# an unrelated edit to default.nix changed the system derivation, vendor_boot
# started pointing the initrd at a closure that was not on the phone, and the
# boot ended in "Failed to start Find NixOS closure" and an emergency shell.
# vendor_boot now adds tegu.cmd= and nothing else, which cannot contradict the
# flashed rootfs and leaves ~327 more bytes for the payload.
base=$(cat "$img/cmdline.txt")
enc=$(printf '%s' "$cmd" | base64 -w0)

# ABL caps vendor_cmdline at 2048 bytes and the base cmdline eats a third of
# it, so a probe script of any size does not fit base64'd. Fall back to
# gzip+base64 with a decode pipeline in front, which is about three times
# denser on shell text. Done here rather than on the phone so that changing
# the encoding never costs a rootfs reflash; the phone still just runs a
# string. The reply is unaffected -- only the BEGIN line echoes as base64.
# The kernel truncates at COMMAND_LINE_SIZE, 2048 on arm64. Three things
# share that buffer and only one of them is ours:
#
#   boot.img's cmdline      ${#base}, currently 327
#   ABL's own cmdline       277, measured off a boot log -- console=,
#                           exynos_drm.panel_name=, the ufs_pixel_fips140
#                           block, bootconfig
#   ours                    " tegu.cmd=" + the base64
#
# Leaving ABL's share out of this sum is what silently truncated the payload
# and made the phone answer "base64 decode failed". The probe prints
# "cmdline bytes:" so the real total is checkable against this arithmetic.
abl=277
room=$(( 2048 - ${#base} - abl - 24 ))
if [ "${#enc}" -gt "$room" ]; then
	gz=$(printf '%s' "$cmd" | gzip -9 | base64 -w0)
	# gunzip by absolute path: the unit's systemd path= replaces PATH, and
	# adding gzip to it costs a rootfs reflash. NixOS always puts gzip in
	# the system profile (it is one of system-path.nix's requiredPackages),
	# so this path exists regardless of what the unit lists.
	cmd="echo $gz|base64 -d|/run/current-system/sw/bin/gunzip|/bin/sh"
	enc=$(printf '%s' "$cmd" | base64 -w0)
	echo "tegu-cmd: compressed, $((${#enc})) of $room bytes" >&2
fi
[ "${#enc}" -le "$room" ] || {
	echo "tegu-cmd: command still too long ($((${#enc})) > $room)" >&2
	exit 1
}

work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
mkdir "$work/empty"
(cd "$work/empty" && find . | cpio -o -H newc --quiet) > "$work/vr.cpio"

"$mkbootimg" --header_version 4 --pagesize 4096 \
	--dtb "$img/zumapro-tegu.dtb" --vendor_ramdisk "$work/vr.cpio" \
	--vendor_cmdline "tegu.cmd=$enc" \
	--vendor_boot "$work/vendor_boot.img"

echo "tegu-cmd: $cmd"
"$fastboot" "${fbargs[@]}" flash vendor_boot "$work/vendor_boot.img"
echo "tegu-cmd: flashed. reboot the phone; the reply appears on the UART."
