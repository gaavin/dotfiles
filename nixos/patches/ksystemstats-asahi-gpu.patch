diff -Naur a/plugins/gpu/LinuxBackend.cpp b/plugins/gpu/LinuxBackend.cpp
--- a/plugins/gpu/LinuxBackend.cpp	2026-08-04 06:51:30.000000000 -0230
+++ b/plugins/gpu/LinuxBackend.cpp	2026-08-24 10:58:25.867658867 -0230
@@ -10,9 +10,12 @@
 
 #include <libudev.h>
 
+#include <cstring>
+
 #include <processcore/gpu_utils.h>
 
 #include "LinuxAmdGpu.h"
+#include "LinuxAsahiGpu.h"
 #include "LinuxIntelGpu.h"
 #include "LinuxNvidiaGpu.h"
 #include "debug.h"
@@ -78,6 +81,38 @@
     }
 
     udev_enumerate_unref(enumerate);
+
+    enumerate = udev_enumerate_new(m_udev);
+    udev_enumerate_add_match_subsystem(enumerate, "drm");
+    udev_enumerate_add_match_sysname(enumerate, "card*");
+    udev_enumerate_scan_devices(enumerate);
+
+    devices = udev_enumerate_get_list_entry(enumerate);
+    for (auto entry = devices; entry; entry = udev_list_entry_get_next(entry)) {
+        auto drmDevice = udev_device_new_from_syspath(m_udev, udev_list_entry_get_name(entry));
+        const char *sysname = udev_device_get_sysname(drmDevice);
+        // Skip connectors (card0-HDMI-A-1) and keep only cardN.
+        if (!sysname || strchr(sysname, '-')) {
+            udev_device_unref(drmDevice);
+            continue;
+        }
+        auto parent = udev_device_get_parent(drmDevice);
+        const char *driver = parent ? udev_device_get_driver(parent) : nullptr;
+        if (!driver || strcmp(driver, "asahi") != 0) {
+            udev_device_unref(drmDevice);
+            continue;
+        }
+
+        auto gpuId = QStringLiteral("gpu%1").arg(gpuNumber);
+        auto *gpu = new LinuxAsahiGpu(gpuId, QStringLiteral("Apple AGX Graphics"), parent);
+        gpu->initialize();
+        m_devices.append(gpu);
+        Q_EMIT deviceAdded(gpu);
+        gpuNumber++;
+        udev_device_unref(drmDevice);
+    }
+
+    udev_enumerate_unref(enumerate);
 }
 
 void LinuxBackend::stop()
