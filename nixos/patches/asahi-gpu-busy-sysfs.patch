diff --git a/drivers/gpu/drm/asahi/gpu_sysfs.c b/drivers/gpu/drm/asahi/gpu_sysfs.c
--- a/drivers/gpu/drm/asahi/gpu_sysfs.c	1969-12-31 20:30:00.000000000 -0330
+++ b/drivers/gpu/drm/asahi/gpu_sysfs.c	2026-08-24 00:37:18.725734645 -0230
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+#include <linux/device.h>
+#include <linux/sysfs.h>
+#include <linux/types.h>
+
+static u32 gpu_busy_percent;
+
+void asahi_gpu_set_busy_percent(u32 percent)
+{
+	WRITE_ONCE(gpu_busy_percent, percent);
+}
+
+static ssize_t gpu_busy_percent_show(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", READ_ONCE(gpu_busy_percent));
+}
+static DEVICE_ATTR_RO(gpu_busy_percent);
+
+int asahi_gpu_sysfs_init(struct device *dev)
+{
+	return device_create_file(dev, &dev_attr_gpu_busy_percent);
+}
+
+void asahi_gpu_sysfs_remove(struct device *dev)
+{
+	device_remove_file(dev, &dev_attr_gpu_busy_percent);
+}
diff --git a/drivers/gpu/drm/asahi/gpu_sysfs.rs b/drivers/gpu/drm/asahi/gpu_sysfs.rs
--- a/drivers/gpu/drm/asahi/gpu_sysfs.rs	1969-12-31 20:30:00.000000000 -0330
+++ b/drivers/gpu/drm/asahi/gpu_sysfs.rs	2026-08-24 00:37:18.725734645 -0230
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! Sysfs hook for firmware-reported AGX GPU utilization.
+
+use kernel::{
+    bindings,
+    device::{
+        Device,
+        DeviceContext, //
+    },
+    error::to_result,
+    prelude::*,
+};
+
+unsafe extern "C" {
+    fn asahi_gpu_sysfs_init(dev: *mut bindings::device) -> kernel::ffi::c_int;
+    fn asahi_gpu_sysfs_remove(dev: *mut bindings::device);
+    fn asahi_gpu_set_busy_percent(percent: u32);
+}
+
+fn as_device_ptr<Ctx: DeviceContext>(dev: &Device<Ctx>) -> *mut bindings::device {
+    core::ptr::from_ref(dev).cast::<bindings::device>().cast_mut()
+}
+
+pub(crate) fn init<Ctx: DeviceContext>(dev: &Device<Ctx>) -> Result {
+    // SAFETY: `Device` is a transparent wrapper around `struct device`.
+    to_result(unsafe { asahi_gpu_sysfs_init(as_device_ptr(dev)) })
+}
+
+pub(crate) fn remove<Ctx: DeviceContext>(dev: &Device<Ctx>) {
+    // SAFETY: Matches a prior `init` on the same device, or is a no-op if create failed.
+    unsafe { asahi_gpu_sysfs_remove(as_device_ptr(dev)) }
+}
+
+pub(crate) fn set_busy_percent(percent: u32) {
+    unsafe { asahi_gpu_set_busy_percent(percent) }
+}
