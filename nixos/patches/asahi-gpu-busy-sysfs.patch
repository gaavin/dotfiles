@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! Sysfs hook for firmware-reported AGX GPU utilization.
+
+use core::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+
+use kernel::{
+    bindings,
+    device::{
+        Device,
+        DeviceContext, //
+    },
+    error::to_result,
+    prelude::*,
+    str::AsCharPtr,
+    sync::SetOnce,
+};
+
+static GPU_BUSY_PERCENT: AtomicU32 = AtomicU32::new(0);
+static GPU_BUSY_ATTR: SetOnce<bindings::device_attribute> = SetOnce::new();
+static REGISTERED: AtomicBool = AtomicBool::new(false);
+
+fn write_u32_percent(buf: *mut u8, val: u32) -> usize {
+    let val = val.min(100);
+    let mut digits = [0u8; 3];
+    let mut len = 0;
+    let mut n = val;
+    if n == 0 {
+        digits[0] = b'0';
+        len = 1;
+    } else {
+        while n > 0 {
+            digits[len] = b'0' + (n % 10) as u8;
+            n /= 10;
+            len += 1;
+        }
+        digits[..len].reverse();
+    }
+    // SAFETY: Sysfs show callbacks receive at least `PAGE_SIZE` bytes.
+    unsafe {
+        core::ptr::copy_nonoverlapping(digits.as_ptr(), buf, len);
+        *buf.add(len) = b'\n';
+    }
+    len + 1
+}
+
+unsafe extern "C" fn gpu_busy_percent_show(
+    _dev: *mut bindings::device,
+    _attr: *mut bindings::device_attribute,
+    buf: *mut kernel::ffi::c_char,
+) -> isize {
+    let val = GPU_BUSY_PERCENT.load(Ordering::Relaxed);
+    write_u32_percent(buf.cast(), val) as isize
+}
+
+fn as_device_ptr<Ctx: DeviceContext>(dev: &Device<Ctx>) -> *mut bindings::device {
+    core::ptr::from_ref(dev).cast::<bindings::device>().cast_mut()
+}
+
+fn make_attr() -> bindings::device_attribute {
+    bindings::device_attribute {
+        attr: bindings::attribute {
+            name: c"gpu_busy_percent".as_char_ptr().cast(),
+            mode: 0o444,
+        },
+        show: Some(gpu_busy_percent_show),
+        store: None,
+    }
+}
+
+pub(crate) fn init<Ctx: DeviceContext>(dev: &Device<Ctx>) -> Result {
+    if REGISTERED.load(Ordering::Acquire) {
+        return Ok(());
+    }
+
+    GPU_BUSY_ATTR.populate(make_attr());
+    let attr = GPU_BUSY_ATTR.as_ref().ok_or(EINVAL)?;
+
+    // SAFETY: `attr` lives in `GPU_BUSY_ATTR` for the module lifetime.
+    to_result(unsafe { bindings::device_create_file(as_device_ptr(dev), attr) })?;
+    REGISTERED.store(true, Ordering::Release);
+    Ok(())
+}
+
+pub(crate) fn remove<Ctx: DeviceContext>(dev: &Device<Ctx>) {
+    if !REGISTERED.load(Ordering::Acquire) {
+        return;
+    }
+
+    if let Some(attr) = GPU_BUSY_ATTR.as_ref() {
+        // SAFETY: Complements a prior successful `init` on the same device.
+        unsafe { bindings::device_remove_file(as_device_ptr(dev), attr) };
+    }
+
+    REGISTERED.store(false, Ordering::Release);
+}
+
+pub(crate) fn set_busy_percent(percent: u32) {
+    GPU_BUSY_PERCENT.store(percent.min(100), Ordering::Relaxed);
+}
