#!/tegu-bin/busybox sh
# Bring-up rescue userspace for tegu. Run with rdinit=/tegu-init.
#
# Two hard-won rules here:
#
#  - Everything lives under /tegu-bin, and the entry point is /tegu-init.
#    The bootloader unpacks the device's own ramdisk on top of this one, and
#    Android's root has /bin as a symlink into /system, so anything in /bin
#    can vanish underfoot.
#  - Progress is reported to /dev/kmsg, never to a console we had to open
#    ourselves. An earlier version used "exec >/dev/console", which takes the
#    whole init down with it if the node is missing, and the only evidence is
#    "Attempted to kill init" with no clue which line failed.
BB=/tegu-bin/busybox
log() {
	# Both sinks on purpose: /dev/kmsg is the durable record, and writing
	# the VT is what actually puts text on the panel. Writes, never exec,
	# and never held open, or fbcon cannot own the console.
	$BB echo "TEGU: $*" >/dev/kmsg 2>/dev/null
	$BB echo "TEGU: $*" >/dev/console 2>/dev/null
}

$BB mkdir -p /proc /sys /dev /tmp
$BB mount -t proc proc /proc 2>/dev/null
$BB mount -t sysfs sys /sys 2>/dev/null
$BB mount -t devtmpfs dev /dev 2>/dev/null
[ -c /dev/kmsg ] || $BB mknod /dev/kmsg c 1 11 2>/dev/null
[ -c /dev/mem ] || $BB mknod /dev/mem c 1 1 2>/dev/null
[ -c /dev/console ] || $BB mknod /dev/console c 5 1 2>/dev/null

# Dump the whole kernel ring buffer to the panel explicitly.
#
# printk hands console output to a kthread, so messages queued before the
# framebuffer console bound are never rendered, and on this device the only
# boots that ever showed text were ones that panicked, because a panic
# force-flushes every console. Writing the buffer out from here is what makes
# the panel a usable log rather than a crash artefact.
$BB dmesg >/dev/console 2>/dev/null

log "rescue init running: $($BB uname -srm)"
$BB --install -s /tegu-bin 2>/dev/null
export PATH=/tegu-bin:$PATH

# Display pipeline: read-only. Writing these registers from here was an
# attempt to fix the console colour and it destabilised the display; the
# format is now reported correctly to the graphics stack instead, which
# converts in software. Kept as a report because it is useful evidence.
DMA=0x19900000; CTRL=0x19900008; SHD=0x19900408
log "DPP L0 enable=$($BB devmem $DMA 2>&1) ctrl=$($BB devmem $CTRL 2>&1) shadow=$($BB devmem $SHD 2>&1)"

# Clock tree state, read back rather than assumed.
#
# The driver reports enabling the HSI2 path but the UFS PHY still fails to
# calibrate, so dump what the registers actually contain. Guessing at this
# from the driver's own log line is how time gets wasted; /dev/mem is right
# here and STRICT_DEVMEM is off for exactly this reason.
#
# Addresses from Google's CAL tables: CMU_TOP 0x26040000, CMU_HSI2 0x13000000.
c() { $BB printf '%-34s %s\n' "$1" "$($BB devmem $2 2>&1)"; }
log "--- CMU_TOP (0x26040000) ---"
log "$(c 'MUX_CLKCMU_HSI2_UFS_EMBD 0x10b8' 0x260410b8)"
log "$(c 'DIV_CLKCMU_HSI2_UFS_EMBD 0x18b0' 0x260418b0)"
log "$(c 'GAT_CLKCMU_HSI2_UFS_EMBD 0x20e0' 0x260420e0)"
log "$(c 'MUX_CLKCMU_HSI2_NOC      0x10b0' 0x260410b0)"
log "$(c 'DIV_CLKCMU_HSI2_NOC      0x18a8' 0x260418a8)"
log "$(c 'GAT_CLKCMU_HSI2_NOC      0x20d8' 0x260420d8)"
log "--- CMU_HSI2 (0x13000000) ---"
log "$(c 'PLL_CON0 NOC_USER        0x610' 0x13000610)"
log "$(c 'PLL_CON0 UFS_EMBD_USER   0x630' 0x13000630)"
log "$(c 'GAT UFS_EMBD I_ACLK      0x210c' 0x1300210c)"
log "$(c 'GAT UFS_EMBD I_UNIPRO    0x2110' 0x13002110)"
log "$(c 'GAT UFS_EMBD I_FMP       0x2114' 0x13002114)"
log "$(c 'GAT QE_UFS_EMBD ACLK     0x20cc' 0x130020cc)"
log "$(c 'GAT SYSREG_HSI2 PCLK     0x20e8' 0x130020e8)"

# UFS device power: gpp0[1], and a re-bind to prove it.
#
# The stock device tree (zumapro-a1-ipop.dtb, from GrapheneOS's tegu kernel
# prebuilts) says the UFS device's VCC rail is a fixed regulator gated by a
# GPIO:
#
#     fixedregulator@0 { compatible = "regulator-fixed";
#                        regulator-name = "ufs-vcc";
#                        gpio = <&gpp0 1 0>; enable-active-high; };
#
# with gpp0 living in pinctrl@10840000 ("google,zumapro-pinctrl"). Pixel 6
# is wired identically -- same block, same bank, same pin -- and mainline's
# gs101 support drives it through a pinctrl driver we do not have for this
# SoC. So nothing in this kernel ever turns that rail on, which is exactly
# consistent with the measured link state: device_present=0, no reset
# asserted, no error latched at any layer.
#
# Writing a pinctrl driver would mean inventing bank tables for zumapro that
# are not published anywhere. Prove the diagnosis first instead: drive the
# pin from here, then re-bind the UFS driver. If storage appears, the cause
# is settled and the driver work is justified; if it does not, we have spent
# one boot instead of a week.
#
# Samsung GPIO bank layout, shared with gs101: CON at +0x00 with four bits
# per pin (1 = output), DAT at +0x04 with one bit per pin. gpp0 is the first
# bank, at offset 0 of the block. Pin 1 is therefore CON bits [7:4] and DAT
# bit 1.
# The other two UFS pins, in pinctrl@13060000 where gph5 is the first (and
# only) bank, so CON is at +0x00 with four bits per pin.
#
#     ufs-refclk-out = gph5-0, samsung,pin-function = <2>
#     ufs-rst-n      = gph5-1, samsung,pin-function = <2>
#
# Measured: CON reads 0x21, so pin 1 (device reset) is at function 2 as the
# stock tree wants, but pin 0 (reference clock out) is at function 1 -- a
# plain GPIO output -- and DAT has it driven LOW. The bootloader parked the
# reference clock rather than leaving it muxed to the UFS block, which is
# the same teardown as dropping VCC: the device is off and unclocked.
#
# Restore just that nibble to function 2. Everything else in the register,
# including the reset pin, is preserved.
GPH5_CON=0x13060000
gcon=$($BB devmem $GPH5_CON 2>/dev/null)
log "gph5 before: CON=$gcon DAT=$($BB devmem 0x13060004 2>/dev/null) PUD=$($BB devmem 0x13060008 2>/dev/null) DRV=$($BB devmem 0x1306000c 2>/dev/null)"
if [ -n "$gcon" ]; then
	newgcon=$(( ($gcon & 0xFFFFFFF0) | 0x2 ))
	$BB devmem $GPH5_CON 32 $newgcon 2>/dev/null
	log "gph5 after:  CON=$($BB devmem $GPH5_CON) (pin0 -> function 2, refclk to UFS)"
else
	log "gph5 read failed; not writing"
fi

GPP0_CON=0x10840000
GPP0_DAT=0x10840004
con=$($BB devmem $GPP0_CON 2>/dev/null)
dat=$($BB devmem $GPP0_DAT 2>/dev/null)
log "gpp0 before: CON=$con DAT=$dat"

if [ -n "$con" ] && [ -n "$dat" ]; then
	# Preserve every other pin's mode; set pin 1 to output and drive high.
	newcon=$(( ($con & 0xFFFFFF0F) | 0x10 ))
	newdat=$(( $dat | 0x2 ))
	$BB devmem $GPP0_CON 32 $newcon 2>/dev/null
	$BB devmem $GPP0_DAT 32 $newdat 2>/dev/null
	log "gpp0 after:  CON=$($BB devmem $GPP0_CON) DAT=$($BB devmem $GPP0_DAT)"
	$BB sleep 1
else
	log "gpp0 read failed; not writing"
fi

UFSDRV=/sys/bus/platform/drivers/exynos-ufshc
if [ -d "$UFSDRV" ]; then
	log "re-binding 13200000.ufs with the VCC rail on"
	$BB echo 13200000.ufs > "$UFSDRV"/bind 2>/dev/null
	$BB sleep 3
	log "--- dmesg since re-bind ---"
	$BB dmesg | $BB tail -30 | while read -r l; do log "$l"; done
	log "block devices: $($BB ls /sys/class/block 2>/dev/null | $BB tr '\n' ' ')"
	log "scsi devices: $($BB ls /sys/class/scsi_device 2>/dev/null | $BB tr '\n' ' ')"
else
	log "no $UFSDRV; driver not registered"
fi

# A shell on the USB gadget serial port when the controller is present, so a
# terminal replaces photographing the panel.
if [ -c /dev/ttyGS0 ]; then
	log "starting shell on /dev/ttyGS0"
	while true; do
		$BB setsid $BB sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1
		$BB sleep 1
	done &
else
	log "no /dev/ttyGS0; USB gadget not present"
fi

# Deliberately NOT starting a shell on /dev/console. fbcon defers taking the
# panel over until something writes to the virtual terminal, and an
# interactive shell holding /dev/console open stops that handover, leaving
# the boot splash on screen with no log at all. The panel is a log, not a
# terminal; input arrives over USB once the gadget works.

# Status page on the panel. The console is the only display this port has,
# so leave something readable on it rather than a bare cursor.
{
	$BB echo ""
	$BB echo "=============================================="
	$BB echo " NixOS / mainline Linux on Google Pixel 9a"
	$BB echo " $($BB uname -srm)"
	$BB echo "=============================================="
	$BB echo " cpus    : $($BB grep -c ^processor /proc/cpuinfo)"
	$BB echo " display : simpledrm on the bootloader framebuffer"
	$BB echo " serial  : ttySAC0 @115200"
	$BB echo "=============================================="
	$BB echo " No root filesystem yet; storage is next."
	$BB echo " See nixos/hosts/tegu/README.md"
	$BB echo "=============================================="
} >/dev/console 2>/dev/null

log "rescue init ready"
# Everything above went to /dev/kmsg; flush it to the panel too.
$BB dmesg | $BB tail -40 >/dev/console 2>/dev/null

while true; do $BB sleep 30; done
